# Variables publiques du client. La clé anon est conçue pour être exposée :
# la sécurité repose sur l'authentification et les politiques RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
# La maquette reste sur mock tant que cette bascule n'est pas explicite.
VITE_DATA_BACKEND=mock

# Variables réservées au backend/worker. Ne jamais les préfixer par VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PPTX_WORKER_CALLBACK_SECRET=replace-with-a-long-random-secret
